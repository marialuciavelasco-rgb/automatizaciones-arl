# ============================================================
# CREDENCIALES ARL SEGUROS BOLÍVAR
# Copia este archivo como ".env" y llena los valores
# NUNCA compartas el archivo .env con nadie
# ============================================================

ARL_USUARIO=tu_usuario_aqui
ARL_PASSWORD=tu_contraseña_aqui

# ============================================================
# FIREBASE
# ============================================================
FIREBASE_PROJECT_ID=nombre-de-tu-proyecto-firebase

# ============================================================
# CONFIGURACIÓN OPCIONAL
# ============================================================
# Modo headless: True = sin ventana, False = con ventana (ver qué hace)
HEADLESS=False

# Velocidad de digitación en ms (más alto = más lento y más humano)
TYPING_DELAY_MS=120

# Timeout general en segundos
TIMEOUT_SECONDS=30
