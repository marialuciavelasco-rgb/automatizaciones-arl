{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{dashboard/**,modules/**,config/**}"
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)",  "dest": "/api/index.py" },
    { "src": "/(.*)",         "dest": "/api/index.py" }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
